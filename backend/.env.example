# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (matches docker-compose.yml)
DATABASE_URL="postgresql://paybridge:paybridge_password@localhost:5432/paybridge_db?schema=public"

# Authentication
JWT_SECRET="paybridge-dev-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Payment Gateway Configuration
# Options: SIMULATOR | MIDTRANS_SANDBOX | MIDTRANS_PRODUCTION
PAYMENT_GATEWAY_MODE="SIMULATOR"
MIDTRANS_SERVER_KEY="SB-Mid-server-SAMPLE_KEY_FOR_TESTING"
MIDTRANS_CLIENT_KEY="SB-Mid-client-SAMPLE_KEY_FOR_TESTING"
MIDTRANS_MERCHANT_ID="G123456789"

# CoinGecko Crypto Market Price API
COINGECKO_API_URL="https://api.coingecko.com/api/v3"
COINGECKO_API_KEY=""

# Background Workers (Polling & Reconciliation)
ENABLE_BACKGROUND_WORKERS="true"
POLLING_INTERVAL_SECONDS=30
RECONCILIATION_CRON="*/5 * * * *"

